{
  "name": "azure-blob-feature-flag",
  "version": "1.0.0",
  "description": "Feature flag management over Azure Blob Storage: versioned definitions with rollback, percentage rollout, targeting rules, and a poll-based watcher (memory:// and file:// stores included for tests and local runs)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "abff": "./dist/cli.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "feature-flags",
    "feature-toggles",
    "azure",
    "blob-storage",
    "rollout",
    "ab-testing",
    "kill-switch",
    "typescript"
  ],
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "demo": "node dist/cli.js demo",
    "prepare": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Retsumdk/azure-blob-feature-flag.git"
  },
  "bugs": {
    "url": "https://github.com/Retsumdk/azure-blob-feature-flag/issues"
  },
  "homepage": "https://github.com/Retsumdk/azure-blob-feature-flag#readme",
  "devDependencies": {
    "@types/node": "22",
    "bun-types": "^1.4.3",
    "typescript": "^5.7.2"
  }
}
